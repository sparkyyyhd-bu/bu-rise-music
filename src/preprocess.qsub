#!/bin/bash -l

#$ -P rise-grid          # project
#$ -N preprocess        # job name
#$ -j y                 # merge stdout/stderr
#$ -o preprocess.qlog   # output log
#$ -l h_rt=12:00:00     # walltime, adjust as needed
#$ -pe omp 8            # CPU cores, matches num_workers in preprocess.py
#$ -l gpus=1            # request 1 GPU
#$ -l gpu_c=7.0         # min GPU compute capability
#$ -l gpu_type=A100     # request a specific GPU model, see `qgpus` for options

module load python3/3.10.12
module load cuda/12.2
module load ffmpeg

cd "$SGE_O_WORKDIR"

# Needs modern torch/torchaudio + torchcodec (mp3 decoding via the ffmpeg backend),
# which the cluster's pytorch module (tops out at 1.13.1) can't provide. Those
# packages are several GB, so install them on scratch instead of the small
# home-directory quota.
VENV_DIR="/net/scc1/scratch/$USER/venv-preprocess"
if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR"
fi
source "$VENV_DIR/bin/activate"
pip install -r requirements-preprocess.txt

python src/preprocess.py
