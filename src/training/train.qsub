#!/bin/bash -l

#$ -P rise-grid          # project
#$ -N train              # job name
#$ -j y                  # merge stdout/stderr
#$ -o train.qlog         # output log
#$ -l h_rt=12:00:00      # walltime, adjust as needed
#$ -pe omp 8             # CPU cores, matches num_workers in train.py
#$ -l gpus=1             # request 1 GPU
#$ -l gpu_c=7.0          # min GPU compute capability
#$ -l gpu_type=H200      # request a specific GPU model, see `qgpus` for options

module load python3/3.10.12
module load cuda/12.2   # CUDA runtime matching the pip PyTorch build below, needed for H200 (sm_90)

cd "$SGE_O_WORKDIR"
pip install --user torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121  # pip build supports sm_90 (H200); module pytorch/1.13.1 tops out at sm_86
pip install --user -r requirements.txt

python src/training/train.py
