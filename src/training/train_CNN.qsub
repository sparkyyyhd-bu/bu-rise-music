#!/bin/bash -l

#$ -P rise-grid          # project
#$ -N train_CNN          # job name
#$ -l h_rt=24:00:00      # walltime, adjust as needed
#$ -pe omp 8             # CPU cores, matches num_workers in train.py
#$ -l gpus=1             # request 1 GPU
#$ -l gpu_c=7.0          # min GPU compute capability
#$ -l gpu_type=L40S      # request a specific GPU model, see `qgpus` for options

module load python3/3.10.12
module load cuda/12.2

cd "$SGE_O_WORKDIR"

# Keep unique, persistent logs for every submission. Grid Engine's default
# train_CNN.o<job_id>/train_CNN.e<job_id> files remain as a fallback for any
# failure that happens before these redirects are established.
mkdir -p "$SGE_O_WORKDIR/logs"
exec >>"$SGE_O_WORKDIR/logs/train_CNN.${JOB_ID}.qlog" \
     2>>"$SGE_O_WORKDIR/logs/train_CNN.${JOB_ID}.err"
echo "job ${JOB_ID} started on $(hostname) at $(date)"

# Needs modern torch (H200 = sm_90), which the cluster's pytorch module (tops out at 1.13.1)
# can't provide. Torch wheels are several GB, so install into a venv in project space
# (persistent, 50GB quota) instead of the small home-directory quota.
VENV_DIR="$SGE_O_WORKDIR/.venv-train"
if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR"
fi
source "$VENV_DIR/bin/activate"
pip install --upgrade pip setuptools
pip install --upgrade -r requirements.txt

python -u src/training/train_CNN.py
