#!/bin/bash -l

#$ -P rise-grid
#$ -N train_hybrid_no_artist
#$ -l h_rt=06:00:00
#$ -pe omp 8

module load python3/3.10.12

PROJECT_STORAGE="${PROJECT_STORAGE:-/project/rise-grid/$USER}"
REPO_DIR="${REPO_DIR:-$PROJECT_STORAGE/bu-rise-music}"
cd "$REPO_DIR"

mkdir -p "$REPO_DIR/logs/hybrid/late_stage_fusion"
exec >>"$REPO_DIR/logs/hybrid/late_stage_fusion/train_hybrid_no_artist.${JOB_ID}.qlog" \
     2>>"$REPO_DIR/logs/hybrid/late_stage_fusion/train_hybrid_no_artist.${JOB_ID}.err"
echo "job ${JOB_ID} started on $(hostname) at $(date)"

VENV_DIR="$PROJECT_STORAGE/venvs/bu-rise-train"
export PIP_CACHE_DIR="$PROJECT_STORAGE/.cache/pip"
mkdir -p "$(dirname "$VENV_DIR")" "$PIP_CACHE_DIR"
if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR"
fi
source "$VENV_DIR/bin/activate"
pip install --upgrade pip setuptools
pip install --upgrade -r requirements.txt

export PYTHONPATH="$REPO_DIR/src:$PYTHONPATH"

python -u src/training/hybrid_ML/late_stage_fusion/train_hybrid_no_artist.py
