#!/bin/bash -l

#$ -P rise-grid
#$ -N test_NN_models
#$ -l h_rt=04:00:00
#$ -pe omp 8
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l gpu_memory=80G

module load python3/3.10.12
module load cuda/12.2

PROJECT_STORAGE="${PROJECT_STORAGE:-/project/rise-grid/$USER}"
REPO_DIR="${REPO_DIR:-$PROJECT_STORAGE/bu-rise-music}"
cd "$REPO_DIR"

mkdir -p "$REPO_DIR/logs"
SPLIT_MODE=legacy
exec >>"$REPO_DIR/logs/test_NN_models_${SPLIT_MODE}.${JOB_ID}.qlog" \
     2>>"$REPO_DIR/logs/test_NN_models_${SPLIT_MODE}.${JOB_ID}.err"
echo "job ${JOB_ID} started on $(hostname) at $(date)"

VENV_DIR="$PROJECT_STORAGE/venvs/bu-rise-train"
export PIP_CACHE_DIR="$PROJECT_STORAGE/.cache/pip"
mkdir -p "$(dirname "$VENV_DIR")" "$PIP_CACHE_DIR"
if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR"
fi
source "$VENV_DIR/bin/activate"
pip install --upgrade pip setuptools
pip install --upgrade -r requirements.txt

export PYTHONPATH="$REPO_DIR/src:$PYTHONPATH"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

python -u src/testing/evaluate_nn_models.py \
    --split-mode "$SPLIT_MODE" \
    --models all \
    --mel-dir "/net/scc1/scratch/$USER/mel_spectrograms" \
    --local-scratch-dir "/scratch/$USER" \
    --checkpoint-dir "/net/scc1/scratch/$USER/checkpoints" \
    --output-dir "$REPO_DIR/results/nn_testing_${SPLIT_MODE}" \
    --num-workers "${NSLOTS:-8}"
