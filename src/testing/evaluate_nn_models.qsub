#!/bin/bash -l

#$ -P rise-grid
#$ -N test_NN_models
#$ -l h_rt=04:00:00
#$ -pe omp 8
#$ -l mem_per_core=5G
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l gpu_memory=80G

module load python3/3.10.12
module load cuda/12.2

cd "$SGE_O_WORKDIR"

mkdir -p "$SGE_O_WORKDIR/logs"
exec >>"$SGE_O_WORKDIR/logs/test_NN_models.${JOB_ID}.qlog" \
     2>>"$SGE_O_WORKDIR/logs/test_NN_models.${JOB_ID}.err"
echo "job ${JOB_ID} started on $(hostname) at $(date)"

PROJECT_STORAGE="${PROJECT_STORAGE:-/project/rise-grid/$USER}"
VENV_DIR="$PROJECT_STORAGE/venvs/bu-rise-train"
export PIP_CACHE_DIR="$PROJECT_STORAGE/.cache/pip"
mkdir -p "$(dirname "$VENV_DIR")" "$PIP_CACHE_DIR"
if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR"
fi
source "$VENV_DIR/bin/activate"
pip install --upgrade pip setuptools
pip install --upgrade -r requirements.txt

export PYTHONPATH="$SGE_O_WORKDIR/src:$PYTHONPATH"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

python -u src/testing/evaluate_nn_models.py \
    --models all \
    --mel-dir "/net/scc1/scratch/$USER/mel_spectrograms" \
    --local-scratch-dir "/scratch/$USER" \
    --checkpoint-dir "/net/scc1/scratch/$USER/checkpoints" \
    --output-dir "$SGE_O_WORKDIR/results/nn_testing" \
    --num-workers "${NSLOTS:-8}"
